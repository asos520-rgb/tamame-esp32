MUSE_STRING(s279, "Chip sleep", "芯片休眠", MUSE_KEY_s279)
MUSE_STRING(s280, "Save up to 8 networks. The strongest nearby saved network connects automatically. Tap a saved network twice to forget it.", "最多可保存 8 个网络，并自动连接范围内讯号最强的网络。连点已保存的网络两次即可忘记。", MUSE_KEY_s280)
