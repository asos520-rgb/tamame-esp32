MUSE_STRING(s274, "Unplug USB to start measuring.", "拔除 USB 即可开始测量。", MUSE_KEY_s274)
MUSE_STRING(s275, "Unplug USB to start; reconnect to finish. Battery updates in 1 percent steps, so measure for several hours. Chip sleep is light sleep; CPU busy is time spent working.", "拔除 USB 后开始测量，重新插入后结束。电量以 1% 为单位更新，请持续测量数小时。「芯片休眠」为浅层睡眠时间；「CPU 忙碌」为核心执行工作的时间。", MUSE_KEY_s275)
MUSE_STRING(s276, "Press the %s button to start again.", "按%s按键可重新开机。", MUSE_KEY_s276)
MUSE_STRING(s277, "Press the %s button to start again. To turn off only the screen, press the %s button.", "按%s按键可重新开机。若只要关闭荧幕，请按%s按键。", MUSE_KEY_s277)
