MUSE_STRING(s294, "Network name", "网络名称", MUSE_KEY_s294)
MUSE_STRING(s295, "Pair with the Muse app to use your account. A device token here overrides pairing. Send long tokens over Bluetooth. VM ID selects a VM. Get an SDK token at gadgets.muse.ai; setting one here overrides the compiled value. Reset pairing clears Wi-Fi and app pairing, then restarts.", "与 Muse App 配对后即可使用你的帐号；在此设置设备令牌会覆盖配对设置。较长的令牌可透过蓝牙传送。VM 识别码可指定使用的 VM。SDK 令牌可从 gadgets.muse.ai 取得，在此设置会取代韧体内的值。重设配对会清除 Wi-Fi 与 App 配对，然后重新启动。", MUSE_KEY_s295)
MUSE_STRING(s296, "Bluetooth", "蓝牙", MUSE_KEY_s296)
MUSE_STRING(s297, "Device token", "设备令牌", MUSE_KEY_s297)
MUSE_STRING(s298, "Turn off device power completely?", "要完全关闭设备电源吗？", MUSE_KEY_s298)
MUSE_STRING(s299, "Settings", "设置", MUSE_KEY_s299)
MUSE_STRING(s300, "Speak at arm's length. Aim for the green range (-30 to -15 dBFS); avoid orange.", "请在一臂距离说话：音量应达绿色范围（-30 至 -15 dBFS），避免进入橘色范围。", MUSE_KEY_s300)
MUSE_STRING(s301, "Tap to forget network", "轻触以忘记网络", MUSE_KEY_s301)
MUSE_STRING(s302, "Tap the screen or press any button to wake.", "轻触荧幕或按任一按键即可唤醒。", MUSE_KEY_s302)
MUSE_STRING(s303, "Optional", "选填", MUSE_KEY_s303)
MUSE_STRING(s304, "Pairing used a different SDK token. Pair again to use the current token", "配对使用了其他 SDK 令牌，请重新配对以使用目前令牌", MUSE_KEY_s304)
MUSE_STRING(s305, "Enable to make the device discoverable. Open tools/ble_setup.html in Chrome, connect, then enter the on-screen pairing code.", "开启后，附近的手机即可找到设备。请使用 Chrome 开启 tools/ble_setup.html，连接后输入荧幕上的配对码。", MUSE_KEY_s305)
