MUSE_STRING(s203, "Luck: Today's coffee may taste extra good.", "吉：今天的咖啡，可能特别香。", MUSE_KEY_s203)
MUSE_STRING(s204, "Luck: Say hello to someone you like today.", "吉：今天适合跟喜欢的人说声嗨。", MUSE_KEY_s204)
MUSE_STRING(s205, "Luck: Someone appreciates your efforts.", "吉：你的努力，有人在心里记着。", MUSE_KEY_s205)
MUSE_STRING(s206, "Luck: Drink some water. Inspiration is near.", "吉：喝口水，灵感就快到了。", MUSE_KEY_s206)
MUSE_STRING(s207, "Luck: Go slowly. You will get where you want.", "吉：慢慢来，也会走到喜欢的地方。", MUSE_KEY_s207)
MUSE_STRING(s208, "Luck: Doing one small thing well is worth celebrating.", "吉：把一件小事做好，就很值得开心。", MUSE_KEY_s208)
MUSE_STRING(s209, "Luck: Make time for yourself. Good things will grow.", "吉：留一点时间给自己，好事会发芽。", MUSE_KEY_s209)
MUSE_STRING(s210, "Coffee", "咖啡", MUSE_KEY_s210)
MUSE_STRING(s211, "Great luck: A little courage brings good news today.", "大吉：今天的小勇气，会带来好消息。", MUSE_KEY_s211)
MUSE_STRING(s212, "Great luck: Start doing what you love today.", "大吉：喜欢的事，现在就开始吧。", MUSE_KEY_s212)
MUSE_STRING(s213, "Great luck: Good fortune is coming. Welcome it.", "大吉：好运正在靠近，记得接住。", MUSE_KEY_s213)
MUSE_STRING(s214, "Small luck: A smile can make today easier.", "小吉：一个微笑，能让今天更顺。", MUSE_KEY_s214)
MUSE_STRING(s215, "Small luck: Enjoy a snack before your next step.", "小吉：先吃点好吃的，再想下一步。", MUSE_KEY_s215)
MUSE_STRING(s216, "Small luck: Done is good. Perfection can wait.", "小吉：别急着完美，先完成就很好。", MUSE_KEY_s216)
MUSE_STRING(s217, "Small luck: Take a walk for a fresh perspective.", "小吉：散个步，让心情换个位置。", MUSE_KEY_s217)
MUSE_STRING(s218, "Small luck: Take one small step with your intuition.", "小吉：跟直觉走一小步看看。", MUSE_KEY_s218)
MUSE_STRING(s219, "Reminder: Too much to do? Start with the smallest task.", "小提醒：事情太多，就先做最小的一件。", MUSE_KEY_s219)
MUSE_STRING(s220, "Reminder: Be kind to yourself today.", "小提醒：今天先别跟自己过不去。", MUSE_KEY_s220)
MUSE_STRING(s221, "Reminder: Sleep early tonight. Shine tomorrow.", "小提醒：今晚早点睡，明天再发光。", MUSE_KEY_s221)
